#!/usr/bin/env bash
#
# Commit-msg hook for FHIRfly public SDK repos.
#
# Checks:
#   1. No Co-Authored-By Claude lines (project convention)
#   2. Identity patterns not in commit message
#
# Setup: git config core.hooksPath .hooks
#
# This file is kept identical across all four SDK repos.
#

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

MSG_FILE="$1"
FAILED=0

# --- 1. No Co-Authored-By Claude ---
if grep -iq "Co-Authored-By:.*Claude" "$MSG_FILE"; then
  echo -e "${RED}BLOCKED: Commit message contains Co-Authored-By Claude line.${NC}"
  echo -e "${RED}Project convention: do not include Co-Authored-By in public SDK commits.${NC}"
  FAILED=1
fi

# --- 2. Identity patterns in commit message ---
BLOCKLIST=""
for candidate in ".identity-blocklist" "../.config/identity-blocklist"; do
  if [ -f "$candidate" ]; then
    BLOCKLIST="$candidate"
    break
  fi
done

PATTERNS=""
if [ -n "$BLOCKLIST" ]; then
  PATTERNS=$(grep -v '^[[:space:]]*#' "$BLOCKLIST" | grep -v '^[[:space:]]*$' | paste -sd'|' - || true)
fi

if [ -z "$PATTERNS" ]; then
  # FAIL CLOSED — see the matching note in .hooks/pre-commit.
  echo -e "${RED}BLOCKED: identity blocklist missing or empty — cannot scan the commit message.${NC}"
  if [ -z "$BLOCKLIST" ]; then
    echo -e "${RED}  No blocklist found. Looked for, relative to the repo root:${NC}"
    echo -e "${YELLOW}    ./.identity-blocklist           (repo-local override, gitignored)${NC}"
    echo -e "${YELLOW}    ../.config/identity-blocklist   (shared by all four SDK repos)${NC}"
  else
    echo -e "${RED}  Found '$BLOCKLIST' but it contains no active patterns.${NC}"
  fi
  echo -e "${YELLOW}  This file is deliberately untracked and lives outside the repo, so it${NC}"
  echo -e "${YELLOW}  has no copy in any remote. Restore it from backup before committing.${NC}"
  echo -e "${YELLOW}  Deliberate bypass: git commit --no-verify${NC}"
  FAILED=1
elif grep -iEq "$PATTERNS" "$MSG_FILE"; then
  echo -e "${RED}BLOCKED: Commit message contains identity patterns.${NC}"
  FAILED=1
fi

if [ $FAILED -ne 0 ]; then
  exit 1
fi
