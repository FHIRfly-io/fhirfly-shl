#!/usr/bin/env bash
#
# Pre-commit hook for FHIRfly public SDK repos.
#
# Checks:
#   1. Identity leak scan — blocks commits containing personal identity patterns
#   2. Secret detection — blocks commits containing API keys or tokens
#   3. Copyright header — ensures all source files have the copyright notice
#   4. TypeScript typecheck — ensures types are sound
#   5. Lint — ensures code style compliance
#
# Setup:
#   git config core.hooksPath .hooks
#
# Identity blocklist (not checked in — lives outside the repo):
#   .identity-blocklist                      (repo-local override, gitignored)
#   ../.config/identity-blocklist            (shared across all SDK repos)
#
# This file is kept identical across all four SDK repos. The licence name in
# the copyright check is read from package.json, so no per-repo edits needed.
# If you change it, change it in all four.
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILED=0

# --- 1. Identity leak scan ---
BLOCKLIST=""
for candidate in ".identity-blocklist" "../.config/identity-blocklist"; do
  if [ -f "$candidate" ]; then
    BLOCKLIST="$candidate"
    break
  fi
done

PATTERNS=""
if [ -n "$BLOCKLIST" ]; then
  PATTERNS=$(grep -v '^[[:space:]]*#' "$BLOCKLIST" | grep -v '^[[:space:]]*$' | paste -sd'|' - || true)
fi

if [ -z "$PATTERNS" ]; then
  # FAIL CLOSED. A missing or empty blocklist previously skipped this check in
  # silence, so the hook printed "All pre-commit checks passed" while scanning
  # nothing at all — on a PUBLIC repo. Never do that again.
  echo -e "${RED}BLOCKED: identity blocklist missing or empty — cannot scan for identity leaks.${NC}"
  if [ -z "$BLOCKLIST" ]; then
    echo -e "${RED}  No blocklist found. Looked for, relative to the repo root:${NC}"
    echo -e "${YELLOW}    ./.identity-blocklist           (repo-local override, gitignored)${NC}"
    echo -e "${YELLOW}    ../.config/identity-blocklist   (shared by all four SDK repos)${NC}"
  else
    echo -e "${RED}  Found '$BLOCKLIST' but it contains no active patterns.${NC}"
  fi
  echo -e "${YELLOW}  This file is deliberately untracked and lives outside the repo, so it${NC}"
  echo -e "${YELLOW}  has no copy in any remote. Restore it from backup before committing.${NC}"
  echo -e "${YELLOW}  Deliberate bypass: git commit --no-verify${NC}"
  FAILED=1
else
  LEAKED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | while read -r file; do
    if [ -f "$file" ] && git show ":$file" 2>/dev/null | grep -iEq "$PATTERNS"; then
      echo "$file"
    fi
  done)

  if [ -n "$LEAKED_FILES" ]; then
    echo -e "${RED}BLOCKED: Identity patterns found in staged files:${NC}"
    for f in $LEAKED_FILES; do
      echo -e "  ${RED}$f${NC}"
      git show ":$f" | grep -inE "$PATTERNS" | head -3 | while read -r line; do
        echo -e "    ${YELLOW}$line${NC}"
      done
    done
    echo -e "${RED}Edit ../.config/identity-blocklist to update patterns.${NC}"
    FAILED=1
  fi
fi

# --- 2. Secret detection ---
SECRET_PATTERNS='ffly_(dev|live|test)_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|sk-[a-zA-Z0-9]{20,}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY'
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED_FILES" ]; then
  SECRET_HITS=$(echo "$STAGED_FILES" | while read -r file; do
    if [ -f "$file" ] && git show ":$file" 2>/dev/null | grep -Eq "$SECRET_PATTERNS"; then
      echo "$file"
    fi
  done)

  if [ -n "$SECRET_HITS" ]; then
    echo -e "${RED}BLOCKED: Possible secrets/API keys found in staged files:${NC}"
    for f in $SECRET_HITS; do
      echo -e "  ${RED}$f${NC}"
    done
    FAILED=1
  fi
fi

# --- 3. Copyright header check ---
# Licence name comes from package.json so this file stays identical across repos
# (fhir-builder is Apache-2.0; the other three are MIT).
LICENSE_ID=$(grep -o '"license"[[:space:]]*:[[:space:]]*"[^"]*"' package.json 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
case "$LICENSE_ID" in
  Apache-2.0) LICENSE_TEXT="Licensed under the Apache License, Version 2.0. See LICENSE file in the project root." ;;
  MIT)        LICENSE_TEXT="Licensed under the MIT License. See LICENSE file in the project root." ;;
  *)          LICENSE_TEXT="Licensed under the $LICENSE_ID License. See LICENSE file in the project root." ;;
esac

COPYRIGHT_PATTERN="^// Copyright [0-9]{4} FHIRfly\.io LLC\. All rights reserved\.$"
MISSING_COPYRIGHT=""
if [ -n "$STAGED_FILES" ]; then
  MISSING_COPYRIGHT=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | while read -r file; do
    if [ -f "$file" ]; then
      FIRST_LINE=$(git show ":$file" 2>/dev/null | head -1)
      if ! echo "$FIRST_LINE" | grep -Eq "$COPYRIGHT_PATTERN"; then
        echo "$file"
      fi
    fi
  done)
fi

if [ -n "$MISSING_COPYRIGHT" ]; then
  echo -e "${RED}BLOCKED: Missing or incorrect copyright header in:${NC}"
  for f in $MISSING_COPYRIGHT; do
    echo -e "  ${RED}$f${NC}"
  done
  echo -e "${YELLOW}Expected line 1: // Copyright $(date +%Y) FHIRfly.io LLC. All rights reserved.${NC}"
  echo -e "${YELLOW}Expected line 2: // $LICENSE_TEXT${NC}"
  FAILED=1
fi

# --- 4. TypeScript typecheck ---
if [ -f "tsconfig.json" ]; then
  echo -e "${GREEN}Running typecheck...${NC}"
  if ! npm run typecheck --silent 2>&1; then
    echo -e "${RED}Typecheck failed.${NC}"
    FAILED=1
  fi
fi

# --- 5. Lint ---
if npm run lint --silent 2>&1; then
  : # success
else
  echo -e "${RED}Lint failed.${NC}"
  FAILED=1
fi

if [ $FAILED -ne 0 ]; then
  echo -e "\n${RED}Pre-commit checks failed. Fix the issues above or use --no-verify to bypass.${NC}"
  exit 1
fi

echo -e "${GREEN}All pre-commit checks passed.${NC}"
